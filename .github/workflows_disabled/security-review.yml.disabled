# ARCHIVED: GitHub does not load this directory or the .disabled extension.
# Retired for this maintained legacy repository: the reviewer executes Claude
# project hooks from PR contents in a process holding an API key. Its successful
# check also does not enforce absence of findings. See ../SECURITY_CI.md.
name: Security Review (archived)

on:
  pull_request:

permissions:
  pull-requests: write
  contents: read

jobs:
  security-review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 2
      - uses: anthropics/claude-code-security-review@0c6a49f1fa56a1d472575da86a94dbc1edb78eda # main@2026-02-11
        with:
          comment-pr: true
          claude-api-key: ${{ secrets.ANTHROPIC_API_KEY }}
          # Review the latest diff on EVERY push to a PR — not just the first
          # commit — so code added after the initial review is still checked.
          run-every-commit: true
          # Repo-specific checks (tenant isolation, authz-vs-attribution, IDOR)
          # layered on top of the default audit.
          custom-security-scan-instructions: .github/security-scan-instructions.md
          exclude-directories: packages/db/src/generated
